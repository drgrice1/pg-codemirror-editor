{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["esnext", "dom"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "strict": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedSideEffectImports": false,
        "rootDir": "./src",
        "paths": {
            "src/*": ["./src/*"]
        }
    },
    "include": ["./src"],
    "exclude": ["./node_modules"]
}
